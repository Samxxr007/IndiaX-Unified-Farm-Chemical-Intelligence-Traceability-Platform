NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://postgres:RENDER_PG_PASSWORD@RENDER_PG_HOST:5432/indiax_db
JWT_SECRET=CHANGE-THIS-TO-64-CHAR-RANDOM-STRING-IN-RENDER-ENV-VARS
JWT_EXPIRES_IN=7d
AI_SERVICE_URL=https://indiax-ai.onrender.com
FRONTEND_URL=https://indiax-unified-farm.vercel.app
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_URL=https://indiax-backend.onrender.com/uploads
LOG_LEVEL=info

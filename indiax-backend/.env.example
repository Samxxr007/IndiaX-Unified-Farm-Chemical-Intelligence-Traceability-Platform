# IndiaX Backend — Environment Configuration

NODE_ENV=development
PORT=5000

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/indiax_db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# AI Model Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_KEY=your-ai-service-api-key

# File Storage (local for hackathon, replace with S3/GCS in production)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_URL=http://localhost:5000/uploads

# CORS
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
